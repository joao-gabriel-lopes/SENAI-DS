@page
@model BarbeariaRazor.Pages.AgendamentoPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Agendamento</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Agendamento.Id" />
            <div class="form-group">
                <label asp-for="Agendamento.Horario" class="control-label"></label>
                <input asp-for="Agendamento.Horario" class="form-control" />
                <span asp-validation-for="Agendamento.Horario" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Agendamento.Confirmado" class="control-label"></label>
                <input asp-for="Agendamento.Confirmado" class="form-check-input" />
                <span asp-validation-for="Agendamento.Confirmado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Agendamento.ClienteId" class="control-label"></label>
                <select asp-for="Agendamento.ClienteId" class="form-select">
                    @foreach (Models.Cliente item in Model.Clientes)
                    {
                        <option value="@item.Id">@item.Nome</option>
                    }

                </select>
                <span asp-validation-for="Agendamento.ClienteId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
